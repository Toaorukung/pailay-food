# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Public base URL of the app. Used to build QR links.
# Must be https in production — geolocation and secure cookies require it.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google Sheets (system of record) ────────────────────────
# 1. Google Cloud Console -> create project -> enable "Google Sheets API"
# 2. Create a Service Account -> Keys -> Add Key -> JSON
# 3. Share your spreadsheet with the service account's email (Editor)
# 4. Base64 the whole JSON file and paste it here:
#      Windows PowerShell:
#        [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#      bash:
#        base64 -w0 key.json
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=""

GOOGLE_SHEET_ID=""

# ── Upstash Redis / Vercel KV (hot store, cache, queue) ─────
# On Vercel: Storage -> Upstash Redis. It injects these automatically.
# Locally: create a free DB at upstash.com and paste the REST creds.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Vercel Blob (slip + menu images) ────────────────────────
# On Vercel: Storage -> Blob. Injected automatically in deployments.
BLOB_READ_WRITE_TOKEN=""

# ── Secrets ─────────────────────────────────────────────────
# Signs the HMAC in printed QR links. Changing it invalidates every
# printed QR code — you would have to reprint them all.
# Generate: openssl rand -base64 32
TABLE_SECRET=""

# Signs guest session cookies.
# Generate: openssl rand -base64 32
SESSION_SECRET=""

# Protects /api/cron/* from public access. Vercel Cron sends this
# automatically as `Authorization: Bearer $CRON_SECRET`.
# Generate: openssl rand -base64 32
CRON_SECRET=""

# ── Admin auth ──────────────────────────────────────────────
# Auth.js / NextAuth secret. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth: console.cloud.google.com -> Credentials -> OAuth client ID
# Authorized redirect URI must be exactly:
#   <NEXT_PUBLIC_APP_URL>/api/admin/auth/google/callback
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── PromptPay ───────────────────────────────────────────────
# Phone number (0812345678) or Tax/National ID (1234567890123)
# of the account that receives payment.
PROMPTPAY_ID=""

# ── LINE (guests arrive from the Official Account) ──────────
# The LIFF app whose endpoint URL is <NEXT_PUBLIC_APP_URL>/order.
# LINE Developers -> your LINE Login channel -> LIFF -> Add.
# Scopes: profile, openid. Size: Full.
NEXT_PUBLIC_LIFF_ID=""

# The LINE Login channel that owns the LIFF app above. Used server-side to
# verify the id token the LIFF SDK hands the page — without it we cannot
# trust which LINE account is ordering, and no confirmation is sent.
LINE_LOGIN_CHANNEL_ID=""

# Messaging API channel access token (long-lived) for the OA that sends the
# order confirmation back to the guest.
# LINE Developers -> Messaging API channel -> Messaging API -> Channel access token
LINE_CHANNEL_ACCESS_TOKEN=""

# ── Lark (staff notification) ───────────────────────────────
# Custom bot webhook for the group that watches for new orders.
# Lark group -> Settings -> Bots -> Add Bot -> Custom Bot -> copy the webhook.
LARK_WEBHOOK_URL=""

# Only if the bot was created with "Signature verification" enabled.
LARK_WEBHOOK_SECRET=""
